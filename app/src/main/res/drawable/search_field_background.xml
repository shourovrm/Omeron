<?xml version="1.0" encoding="utf-8"?>
<!-- Outlined text field: 1dp outline, 2dp primary outline while the input inside has focus.
     The container takes the focused state from its children through addStatesFromChildren. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/chip_radius"/>
            <stroke
                android:width="2dp"
                android:color="?attr/colorPrimary"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/chip_radius"/>
            <stroke
                android:width="@dimen/divider_thickness"
                android:color="?attr/colorOutline"/>
        </shape>
    </item>
</selector>
