<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Theme -->

    <style name="BaseTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/md_primary</item>
        <item name="colorOnPrimary">@color/md_on_primary</item>
        <item name="colorPrimaryContainer">@color/md_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/md_on_primary_container</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="colorSecondaryContainer">@color/md_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/md_on_secondary_container</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>

        <item name="android:colorBackground">@color/md_surface</item>
        <item name="colorSurface">@color/md_surface</item>
        <item name="colorOnSurface">@color/md_on_surface</item>
        <item name="colorOnBackground">@color/md_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/md_on_surface_variant</item>
        <item name="colorOutline">@color/md_outline</item>
        <item name="omeronOutlineVariant">@color/md_outline_variant</item>
        <item name="colorError">@color/md_error</item>
        <item name="colorOnError">@color/md_on_error</item>
        <item name="colorErrorContainer">@color/md_error_container</item>
        <item name="colorOnErrorContainer">@color/md_on_error_container</item>

        <!-- The pinned Material library predates the surface container attributes, so the app owns them. -->
        <item name="omeronSurfaceContainerLow">@color/md_surface_container_low</item>
        <item name="omeronSurfaceContainer">@color/md_surface_container</item>
        <item name="omeronSurfaceContainerHigh">@color/md_surface_container_high</item>
        <item name="omeronMarker">@color/md_marker</item>

        <item name="android:textColor">@color/text_color</item>
        <item name="actionBarSize">@dimen/app_bar_height</item>

        <item name="textAppearanceHeadline6">@style/TextAppearance.App.TitleLarge</item>
        <item name="textAppearanceSubtitle1">@style/TextAppearance.App.TitleMedium</item>
        <item name="textAppearanceSubtitle2">@style/TextAppearance.App.TitleSmall</item>
        <item name="textAppearanceBody1">@style/TextAppearance.App.BodyLarge</item>
        <item name="textAppearanceBody2">@style/TextAppearance.App.BodyMedium</item>
        <item name="textAppearanceCaption">@style/TextAppearance.App.BodySmall</item>
        <item name="textAppearanceButton">@style/TextAppearance.App.LabelLarge</item>
        <item name="textAppearanceOverline">@style/TextAppearance.App.LabelMedium</item>

        <item name="redditTextViewStyle">@style/Widget.App.RedditText</item>

        <item name="preferenceTheme">@style/PreferenceTheme</item>

        <item name="switchStyle">@style/SwitchStyle</item>

        <item name="materialAlertDialogTheme">@style/MaterialAlertDialogTheme</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.App.BottomSheetDialog</item>
        <item name="popupMenuStyle">@style/Widget.App.PopupMenu</item>
        <item name="snackbarButtonStyle">@style/Widget.App.SnackbarButton</item>
        <item name="snackbarTextViewStyle">@style/Widget.App.SnackbarTextView</item>
        <item name="bottomNavigationStyle">@style/Widget.App.BottomNavigation</item>
        <item name="chipStyle">@style/Widget.App.Chip</item>
        <item name="materialButtonStyle">@style/ButtonStyle</item>
    </style>

    <style name="AppTheme" parent="BaseTheme"/>

    <style name="AppTheme.Launcher" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

    <!-- Full-screen page shown as a dialog (multireddit edit); keeps the app's own colours and
         day/night switching, only the floating dialog window is replaced. -->
    <style name="FullscreenDialogTheme" parent="AppTheme">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">?attr/colorSurface</item>
    </style>

    <!-- Text roles. Size, line height and weight come from the design system; colour is left to the theme. -->

    <style name="TextAppearance.App.HeadlineSmall" parent="">
        <item name="android:textSize">24sp</item>
        <item name="android:lineHeight" tools:targetApi="p">32sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.App.TitleLarge" parent="">
        <item name="android:textSize">22sp</item>
        <item name="android:lineHeight" tools:targetApi="p">28sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.App.TitleMedium" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:lineHeight" tools:targetApi="p">24sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.App.TitleSmall" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:lineHeight" tools:targetApi="p">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.App.BodyLarge" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:lineHeight" tools:targetApi="p">24sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.App.BodyMedium" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:lineHeight" tools:targetApi="p">20sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.App.BodySmall" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:lineHeight" tools:targetApi="p">16sp</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="TextAppearance.App.LabelLarge" parent="">
        <item name="android:textSize">14sp</item>
        <item name="android:lineHeight" tools:targetApi="p">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.App.LabelMedium" parent="">
        <item name="android:textSize">12sp</item>
        <item name="android:lineHeight" tools:targetApi="p">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Variants of a role that only add a colour. -->

    <style name="TextAppearance.App.BodyMedium.Variant" parent="TextAppearance.App.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearance.App.BodySmall.Variant" parent="TextAppearance.App.BodySmall">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="TextAppearanceAppBarLabel" parent="TextAppearance.App.TitleLarge"/>

    <!-- The wordmark is the one place the brand typeface and capitals stay. -->
    <style name="TextAppearanceAppName" parent="TextAppearance.App.TitleLarge">
        <item name="android:textAllCaps">true</item>
        <item name="android:fontFamily">@font/inter_bold</item>
    </style>

    <!-- Surfaces and shapes -->

    <style name="CardStyle" parent="Widget.MaterialComponents.CardView">
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardBackgroundColor">?attr/omeronSurfaceContainer</item>
        <item name="android:layout_marginStart">@dimen/space_16</item>
        <item name="android:layout_marginEnd">@dimen/space_16</item>
        <item name="android:layout_marginTop">@dimen/space_8</item>
        <item name="android:layout_marginBottom">@dimen/space_8</item>
    </style>

    <style name="CardButtonStyle" parent="Widget.MaterialComponents.CardView">
        <item name="cardElevation">@dimen/app_bar_button_elevation</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <style name="RoundedImageViewStyle" parent="">
        <item name="cornerSize">@dimen/card_radius</item>
    </style>

    <style name="CircularImageViewStyle" parent="">
        <item name="cornerSize">50%</item>
    </style>

    <style name="Widget.ShapeableImageView.Circular" parent="">
        <item name="contentPadding">@dimen/space_4</item>
        <item name="shapeAppearanceOverlay">@style/CircularImageViewStyle</item>
    </style>

    <!-- Buttons: 40dp visual height inside a 48dp target, full radius, labelLarge. -->

    <style name="ShapeAppearanceButton" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Gallery viewer thumbnails: rounded squares, so they read as images and not as buttons. -->
    <style name="ShapeAppearance.App.Thumbnail" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/chip_radius</item>
    </style>

    <style name="ButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="shapeAppearance">@style/ShapeAppearanceButton</item>
        <item name="android:textAppearance">@style/TextAppearance.App.LabelLarge</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:minWidth">@dimen/touch_target</item>
        <item name="android:insetTop">@dimen/space_4</item>
        <item name="android:insetBottom">@dimen/space_4</item>
        <item name="android:paddingStart">@dimen/space_24</item>
        <item name="android:paddingEnd">@dimen/space_24</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
    </style>

    <style name="ButtonStyle.Tonal">
        <item name="backgroundTint">?attr/colorSecondaryContainer</item>
        <item name="android:textColor">?attr/colorOnSecondaryContainer</item>
    </style>

    <style name="ButtonStyle.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="shapeAppearance">@style/ShapeAppearanceButton</item>
        <item name="android:textAppearance">@style/TextAppearance.App.LabelLarge</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:minWidth">@dimen/touch_target</item>
        <item name="android:insetTop">@dimen/space_4</item>
        <item name="android:insetBottom">@dimen/space_4</item>
        <item name="android:paddingStart">@dimen/space_24</item>
        <item name="android:paddingEnd">@dimen/space_24</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <!-- Destructive actions use an outlined button in the error colour and a confirm dialog. -->
    <style name="ButtonStyle.Outlined.Destructive">
        <item name="strokeColor">?attr/colorError</item>
        <item name="android:textColor">?attr/colorError</item>
    </style>

    <style name="ButtonStyle.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="shapeAppearance">@style/ShapeAppearanceButton</item>
        <item name="android:textAppearance">@style/TextAppearance.App.LabelLarge</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:minWidth">@dimen/touch_target</item>
        <item name="android:insetTop">@dimen/space_4</item>
        <item name="android:insetBottom">@dimen/space_4</item>
        <item name="android:paddingStart">@dimen/space_12</item>
        <item name="android:paddingEnd">@dimen/space_12</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <!-- Chips: 32dp high, radius 8dp, 1dp outline or tonal fill, labelLarge. -->

    <style name="ShapeAppearance.App.Chip" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/chip_radius</item>
    </style>

    <style name="Widget.App.Chip" parent="Widget.MaterialComponents.Chip.Action">
        <item name="shapeAppearance">@style/ShapeAppearance.App.Chip</item>
        <item name="android:textAppearance">@style/TextAppearance.App.LabelLarge</item>
        <item name="chipMinHeight">@dimen/chip_height</item>
        <item name="chipMinTouchTargetSize">@dimen/touch_target</item>
        <item name="chipStrokeWidth">@dimen/divider_thickness</item>
        <item name="chipStrokeColor">?attr/colorOutline</item>
        <item name="chipBackgroundColor">@android:color/transparent</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="ChipActionStyle" parent="Widget.App.Chip">
        <item name="chipIconTint">?attr/colorPrimary</item>
        <item name="chipStartPadding">@dimen/space_16</item>
        <item name="chipEndPadding">@dimen/space_16</item>
        <item name="android:textAlignment">center</item>
    </style>

    <style name="ChipChoiceStyle" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="shapeAppearance">@style/ShapeAppearance.App.Chip</item>
        <item name="android:textAppearance">@style/TextAppearance.App.LabelLarge</item>
        <item name="chipMinHeight">@dimen/chip_height</item>
        <item name="chipMinTouchTargetSize">@dimen/touch_target</item>
        <item name="chipIconVisible">true</item>
        <item name="chipBackgroundColor">@color/chip_background_color</item>
        <item name="android:textColor">@color/chip_text_color</item>
    </style>

    <!-- Navigation and bars -->

    <style name="Widget.App.BottomNavigation" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="android:minHeight">@dimen/bottom_bar_height</item>
        <item name="backgroundTint">?attr/omeronSurfaceContainer</item>
        <item name="elevation">@dimen/bottom_navigation_elevation</item>
        <item name="labelVisibilityMode">labeled</item>
        <item name="itemIconTint">@drawable/navigation_color_selector</item>
        <item name="itemTextColor">@drawable/navigation_color_selector</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.App.LabelMedium</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.App.LabelMedium</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.App.BottomNavigation.ActiveIndicator</item>
    </style>

    <style name="Widget.App.BottomNavigation.ActiveIndicator" parent="">
        <item name="android:width">@dimen/bottom_bar_indicator_width</item>
        <item name="android:height">@dimen/bottom_bar_indicator_height</item>
        <item name="android:color">?attr/colorSecondaryContainer</item>
        <item name="marginHorizontal">@dimen/space_4</item>
        <item name="shapeAppearance">@style/ShapeAppearance.App.Pill</item>
    </style>

    <style name="ShapeAppearance.App.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="TabLayoutStyle" parent="Widget.MaterialComponents.TabLayout">
        <item name="tabIndicator">@drawable/tab_indicator</item>
        <item name="tabIndicatorFullWidth">false</item>
        <item name="tabIndicatorColor">?attr/colorPrimary</item>
        <item name="tabGravity">center</item>
        <item name="tabSelectedTextColor">?attr/colorPrimary</item>
        <item name="tabTextColor">?attr/colorOnSurfaceVariant</item>
        <item name="tabTextAppearance">@style/TextAppearance.App.LabelLarge</item>
        <item name="android:background">?attr/colorSurface</item>
    </style>

    <!-- Sheets, dialogs, menus -->

    <style name="ThemeOverlay.App.BottomSheetDialog" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.BottomSheetDialog</item>
    </style>

    <style name="Widget.BottomSheetDialog" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.BottomSheetDialog</item>
        <item name="backgroundTint">?attr/omeronSurfaceContainerLow</item>
    </style>

    <style name="ShapeAppearance.BottomSheetDialog" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerSizeTopRight">@dimen/bottom_sheet_radius</item>
        <item name="cornerSizeTopLeft">@dimen/bottom_sheet_radius</item>
        <item name="cornerSizeBottomRight">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerFamily">rounded</item>
    </style>

    <style name="MaterialAlertDialogTheme" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="alertDialogStyle">@style/MaterialAlertDialogStyle</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialogTitleText</item>
        <item name="materialAlertDialogBodyTextStyle">@style/MaterialAlertDialogBodyText</item>
        <item name="android:checkedTextViewStyle">@style/MaterialAlertDialogBodyText</item>
        <item name="buttonBarPositiveButtonStyle">@style/ButtonStyle.Text</item>
        <item name="buttonBarNegativeButtonStyle">@style/ButtonStyle.Text</item>
        <item name="buttonBarNeutralButtonStyle">@style/ButtonStyle.Text</item>
    </style>

    <style name="MaterialAlertDialogStyle" parent="MaterialAlertDialog.MaterialComponents">
        <item name="shapeAppearance">@style/MaterialAlertDialogShapeAppearance</item>
    </style>

    <style name="MaterialAlertDialogShapeAppearance" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/bottom_sheet_radius</item>
    </style>

    <style name="MaterialAlertDialogTitleText" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textAppearance">@style/TextAppearance.App.TitleLarge</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="MaterialAlertDialogBodyText" parent="MaterialAlertDialog.MaterialComponents.Body.Text">
        <item name="android:textAppearance">@style/TextAppearance.App.BodyMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Widget.App.PopupMenu" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@drawable/popup_menu_background</item>
    </style>

    <style name="Widget.App.SnackbarButton" parent="Widget.MaterialComponents.Button.TextButton.Snackbar">
        <item name="android:textColor">?attr/colorPrimaryContainer</item>
    </style>

    <style name="Widget.App.SnackbarTextView" parent="Widget.MaterialComponents.Snackbar.TextView">
        <item name="android:textColor">?attr/colorSurface</item>
    </style>

    <!-- Shared text -->

    <style name="TextAppearanceMenu" parent="TextAppearance.App.TitleMedium"/>

    <style name="Widget.TextView.Refresh" parent="Widget.MaterialComponents.TextView">
        <item name="android:textAppearance">@style/TextAppearance.App.BodySmall.Variant</item>
        <item name="android:gravity">center</item>
    </style>

</resources>
