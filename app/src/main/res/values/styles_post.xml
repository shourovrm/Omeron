<resources>

    <!-- Self text and comment bodies are built in code from RedditTextView, so the role comes from the theme. -->
    <style name="Widget.App.RedditText" parent="">
        <item name="android:textAppearance">@style/TextAppearance.App.BodyLarge</item>
    </style>

    <style name="TextAppearanceCommentAuthor" parent="TextAppearance.App.TitleSmall"/>

    <style name="TextAppearanceCommentInfo" parent="TextAppearance.App.BodyMedium.Variant"/>

    <!-- "Load more" rows are text buttons. -->
    <style name="TextAppearanceCommentMore" parent="TextAppearance.App.LabelLarge">
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="TextAppearanceCommentControversiality" parent="TextAppearance.App.LabelMedium">
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <!-- The OP marker is a status pill; the pill background lives in the layout. -->
    <style name="TextAppearanceCommentOp" parent="TextAppearance.App.LabelMedium">
        <item name="android:textColor">?attr/colorOnPrimaryContainer</item>
    </style>

    <!-- Post media runs edge to edge, so its corners are square. -->
    <style name="SquareImageViewStyle" parent="">
        <item name="cornerSize">0dp</item>
    </style>

    <!-- Compact rows keep a small thumbnail with 8dp corners. -->
    <style name="ThumbnailImageViewStyle" parent="">
        <item name="cornerSize">8dp</item>
    </style>

    <!-- A text post title sits in a full-width frame in the headlineSmall role. -->
    <style name="TextAppearancePostTextFrameTitle" parent="TextAppearance.App.HeadlineSmall"/>

    <!-- Edge print: community and age above the picture. -->
    <style name="TextAppearancePostEdgePrint" parent="TextAppearance.App.BodySmall.Variant"/>

</resources>
