<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/space_64"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="@dimen/space_16"
    android:paddingVertical="@dimen/space_8"
    android:background="?attr/selectableItemBackground">

    <!-- Without a preview the thumbnail stays an empty block in the neutral card colour. -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/history_thumbnail"
        android:layout_width="@dimen/profile_history_thumbnail_size"
        android:layout_height="@dimen/profile_history_thumbnail_size"
        android:background="@color/chip_background_color"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/RoundedImageViewStyle"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/space_12"
        android:orientation="vertical">

        <TextView
            android:id="@+id/history_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.App.TitleMedium"
            tools:text="My first hand-wired build, 62 keys"/>

        <TextView
            android:id="@+id/history_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceCaption"
            android:textColor="@color/text_color_post_info"
            tools:text="r/MechanicalKeyboards · 20m ago"/>

    </LinearLayout>

    <ImageButton
        android:id="@+id/history_more"
        android:layout_width="@dimen/post_action_button_size"
        android:layout_height="@dimen/post_action_button_size"
        android:layout_marginStart="@dimen/space_4"
        android:padding="@dimen/post_action_button_padding"
        android:scaleType="fitCenter"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/post_more_description"
        app:srcCompat="@drawable/ic_more"
        app:tint="@color/text_color_secondary"/>

</LinearLayout>
