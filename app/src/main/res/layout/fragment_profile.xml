<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="profile"
            type="com.omeron.data.model.db.Profile" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".MainActivity">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_app_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_begin="?attr/actionBarSize" />

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/layout_toggle_card"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/guideline_app_bar"
            android:layout_marginStart="@dimen/space_16"
            android:singleLine="true"
            android:text="@string/navigation_label_you"
            android:textAppearance="@style/TextAppearanceAppBarLabel"/>

        <com.omeron.ui.common.widget.CardButton
            android:id="@+id/layout_toggle_card"
            android:layout_width="@dimen/app_bar_button_size"
            android:layout_height="@dimen/app_bar_button_size"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/search_card"
            app:layout_constraintBottom_toBottomOf="@id/guideline_app_bar"
            android:layout_marginEnd="@dimen/app_bar_margin"
            app:icon="@drawable/ic_layout_card"
            android:contentDescription="@string/layout_toggle_card"
            style="@style/CardButtonStyle"/>

        <com.omeron.ui.common.widget.CardButton
            android:id="@+id/search_card"
            android:layout_width="@dimen/app_bar_button_size"
            android:layout_height="@dimen/app_bar_button_size"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/settings_card"
            app:layout_constraintBottom_toBottomOf="@id/guideline_app_bar"
            android:layout_marginEnd="@dimen/app_bar_margin"
            app:icon="@drawable/ic_search"
            android:contentDescription="@string/profile_search_hint"
            style="@style/CardButtonStyle"/>

        <com.omeron.ui.common.widget.CardButton
            android:id="@+id/settings_card"
            android:layout_width="@dimen/app_bar_button_size"
            android:layout_height="@dimen/app_bar_button_size"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/guideline_app_bar"
            android:layout_marginEnd="@dimen/app_bar_margin"
            app:icon="@drawable/ic_outline_settings"
            android:contentDescription="@string/navigation_label_settings"
            style="@style/CardButtonStyle"/>

        <com.omeron.ui.common.widget.CardButton
            android:id="@+id/cancel_card"
            android:layout_width="@dimen/app_bar_button_size"
            android:layout_height="@dimen/app_bar_button_size"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/guideline_app_bar"
            android:layout_marginEnd="@dimen/app_bar_margin"
            app:icon="@drawable/ic_close"
            style="@style/CardButtonStyle"/>

        <com.omeron.ui.common.widget.SearchInputEditText
            android:id="@+id/search_input"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/cancel_card"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/guideline_app_bar"
            android:layout_marginHorizontal="@dimen/app_bar_margin"
            android:backgroundTint="@android:color/transparent"
            android:hint="@string/profile_search_hint"
            android:inputType="text"
            android:imeOptions="actionSearch|flagNoPersonalizedLearning"/>

        <LinearLayout
            android:id="@+id/profile_row"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/guideline_app_bar"
            android:layout_marginStart="@dimen/space_16"
            android:layout_marginEnd="@dimen/space_16"
            android:layout_marginTop="@dimen/space_4"
            android:layout_marginBottom="@dimen/space_8"
            android:minHeight="@dimen/space_48"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="@dimen/space_12"
            android:background="@drawable/profile_row_background"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/drawer_switch_profile">

            <com.omeron.ui.common.widget.AvatarView
                android:id="@+id/profile_image"
                android:layout_width="@dimen/manage_row_image_size"
                android:layout_height="@dimen/manage_row_image_size"
                android:importantForAccessibility="no"
                app:text="@{profile.name}"
                tools:text="DE"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/space_12"
                android:orientation="vertical">

                <!-- Packed chain with bias 0 keeps the chevron right after the name, and lets a
                     long name shrink (constrainedWidth) instead of pushing the chevron off. -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/profile_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/profile_chevron"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintHorizontal_chainStyle="packed"
                        app:layout_constraintHorizontal_bias="0"
                        app:layout_constrainedWidth="true"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@{profile.name}"
                        android:textAppearance="@style/TextAppearance.App.TitleMedium"
                        tools:text="Default profile"/>

                    <ImageView
                        android:id="@+id/profile_chevron"
                        android:layout_width="@dimen/space_24"
                        android:layout_height="@dimen/space_24"
                        app:layout_constraintStart_toEndOf="@id/profile_name"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_expand_more"
                        app:tint="@color/icon_tint"/>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/reddit_status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="?attr/textAppearanceCaption"
                    android:textColor="@color/text_color_post_info"
                    tools:text="Reddit: logged in"/>

            </LinearLayout>

        </LinearLayout>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/profile_row"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:tabMode="scrollable"
            app:tabGravity="start"
            style="@style/TabLayoutStyle"/>

        <LinearLayout
            android:id="@+id/selection_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tabs"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/space_4"
            android:background="?attr/omeronSurfaceContainer">

            <ImageButton
                android:id="@+id/selection_leave"
                android:layout_width="@dimen/space_48"
                android:layout_height="@dimen/space_48"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/profile_selection_leave"
                android:src="@drawable/ic_close"
                app:tint="@color/icon_tint"/>

            <ImageButton
                android:id="@+id/selection_select_all"
                android:layout_width="@dimen/space_48"
                android:layout_height="@dimen/space_48"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/profile_selection_select_all"
                android:src="@drawable/ic_check_box_outline_blank"
                app:tint="@color/icon_tint"/>

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1"/>

            <ImageButton
                android:id="@+id/selection_action"
                android:layout_width="@dimen/space_48"
                android:layout_height="@dimen/space_48"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/profile_selection_unsave"
                android:src="@drawable/ic_bookmark_remove"
                app:tint="@color/icon_tint"/>

        </LinearLayout>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/view_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/selection_bar" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
