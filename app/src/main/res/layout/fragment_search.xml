<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/search_field"
        android:layout_width="0dp"
        android:layout_height="48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginHorizontal="@dimen/app_bar_margin"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:background="@drawable/background_drawer_filter">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_search"
            app:tint="?attr/colorControlNormal"/>

        <!-- Shown when the search is limited to one community; its close icon lifts the limit. -->
        <com.google.android.material.chip.Chip
            android:id="@+id/chip_scope"
            style="@style/Widget.MaterialComponents.Chip.Entry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:checkable="false"
            android:maxWidth="160dp"
            android:ellipsize="end"
            android:visibility="gone"
            app:chipBackgroundColor="?attr/colorSurface"
            app:closeIconEnabled="true"
            tools:text="r/Android"
            tools:visibility="visible"/>

        <EditText
            android:id="@+id/input_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:background="@null"
            android:hint="@string/search_hint_reddit"
            android:importantForAutofill="no"
            android:inputType="text"
            android:imeOptions="actionSearch|flagNoPersonalizedLearning"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceBody1"/>

        <ImageButton
            android:id="@+id/button_clear"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/search_clear_description"
            android:padding="14dp"
            android:visibility="gone"
            app:tint="?attr/colorControlNormal"
            app:srcCompat="@drawable/ic_close"
            tools:visibility="visible"/>
    </LinearLayout>

    <TextView
        android:id="@+id/text_query_hint"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/search_field"
        android:layout_marginHorizontal="@dimen/app_bar_margin"
        android:layout_marginTop="6dp"
        android:textAppearance="?attr/textAppearanceCaption"
        android:textColor="@color/text_color_secondary"
        android:visibility="gone"
        tools:text="Type at least 3 characters"
        tools:visibility="visible"/>

    <LinearLayout
        android:id="@+id/layout_results"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_query_hint"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="4dp"
        android:orientation="vertical"
        android:visibility="gone">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:tabMode="scrollable"
            style="@style/TabLayoutStyle"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/row_sort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:background="?attr/colorSurface">

            <com.omeron.ui.common.widget.SortIconView
                android:id="@+id/sort_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:paddingHorizontal="@dimen/app_bar_margin"
                app:sortType="search"/>

            <com.omeron.ui.common.widget.CardButton
                android:id="@+id/sort_card"
                android:layout_width="@dimen/app_bar_button_size"
                android:layout_height="@dimen/app_bar_button_size"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_marginEnd="@dimen/app_bar_margin"
                app:icon="@drawable/ic_sort"
                style="@style/CardButtonStyle"/>

            <com.omeron.ui.common.widget.CardButton
                android:id="@+id/layout_toggle_card"
                android:layout_width="@dimen/app_bar_button_size"
                android:layout_height="@dimen/app_bar_button_size"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/sort_card"
                android:layout_marginEnd="@dimen/app_bar_margin"
                android:contentDescription="@string/layout_toggle"
                app:icon="@drawable/ic_layout_card"
                style="@style/CardButtonStyle"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/view_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list_suggestions"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_query_hint"
        app:layout_constraintBottom_toBottomOf="parent"
        android:clipToPadding="false"
        android:overScrollMode="never"/>

</androidx.constraintlayout.widget.ConstraintLayout>
