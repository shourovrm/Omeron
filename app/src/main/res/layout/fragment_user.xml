<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="user"
            type="com.omeron.data.model.User" />
    </data>

    <androidx.constraintlayout.motion.widget.MotionLayout
        android:id="@+id/layout_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".MainActivity"
        app:layoutDescription="@xml/scene_user"
        tools:showPaths="true">

        <!-- The banner is dimmed toward the surface colour, so the bar icons and the name keep
             their contrast on any picture and in every theme. -->
        <ImageView
            android:id="@+id/user_banner"
            android:layout_width="match_parent"
            android:layout_height="@dimen/user_banner_height"
            app:layout_constraintTop_toTopOf="parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:background="?attr/colorSurface"
            android:src="@color/colorPrimaryLight"/>

        <View
            android:id="@+id/user_banner_scrim"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="@id/user_banner"
            app:layout_constraintEnd_toEndOf="@id/user_banner"
            app:layout_constraintTop_toTopOf="@id/user_banner"
            app:layout_constraintBottom_toBottomOf="@id/user_banner"
            android:background="@drawable/banner_scrim"/>

        <com.omeron.ui.common.widget.CardButton
            android:id="@+id/back_card"
            android:layout_width="@dimen/app_bar_button_size"
            android:layout_height="@dimen/app_bar_button_size"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/guideline_app_bar"
            android:layout_marginStart="@dimen/app_bar_margin"
            app:icon="@drawable/ic_arrow_back"
            style="@style/CardButtonStyle"/>

        <com.omeron.ui.common.widget.CardButton
            android:id="@+id/sort_card"
            android:layout_width="@dimen/app_bar_button_size"
            android:layout_height="@dimen/app_bar_button_size"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/guideline_app_bar"
            android:layout_marginEnd="@dimen/app_bar_margin"
            app:icon="@drawable/ic_sort"
            style="@style/CardButtonStyle"/>

        <com.omeron.ui.common.widget.CardButton
            android:id="@+id/layout_toggle_card"
            android:layout_width="@dimen/app_bar_button_size"
            android:layout_height="@dimen/app_bar_button_size"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/sort_card"
            app:layout_constraintBottom_toBottomOf="@id/guideline_app_bar"
            android:contentDescription="@string/layout_toggle"
            app:icon="@drawable/ic_layout_card"
            style="@style/CardButtonStyle"/>

        <com.omeron.ui.common.widget.CardButton
            android:id="@+id/follow_card"
            android:layout_width="@dimen/app_bar_button_size"
            android:layout_height="@dimen/app_bar_button_size"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/layout_toggle_card"
            app:layout_constraintBottom_toBottomOf="@id/guideline_app_bar"
            android:contentDescription="@string/follow"
            app:icon="@drawable/ic_follow"
            style="@style/CardButtonStyle"/>

        <com.omeron.ui.common.widget.CardButton
            android:id="@+id/add_to_multi_card"
            android:layout_width="@dimen/app_bar_button_size"
            android:layout_height="@dimen/app_bar_button_size"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/follow_card"
            app:layout_constraintBottom_toBottomOf="@id/guideline_app_bar"
            android:contentDescription="@string/add_to_multireddit"
            app:icon="@drawable/ic_add"
            style="@style/CardButtonStyle"/>

        <com.omeron.ui.common.widget.SortIconView
            android:id="@+id/sort_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/add_to_multi_card"
            app:layout_constraintBottom_toBottomOf="@id/guideline_app_bar"
            android:paddingHorizontal="@dimen/app_bar_margin"
            app:sortType="user"/>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/user_image"
            android:layout_width="@dimen/user_image_size_expanded"
            android:layout_height="@dimen/user_image_size_expanded"
            android:cropToPadding="true"
            app:shapeAppearanceOverlay="@style/CircularImageViewStyle"
            android:contentDescription="@null"
            tools:src="@tools:sample/avatars"/>

        <TextView
            android:id="@+id/user_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@{user.displayName}"
            android:textAppearance="@style/TextAppearanceAppBarLabel"
            android:ellipsize="none"
            android:singleLine="true"
            android:requiresFadingEdge="horizontal"
            tools:text="User"/>

        <TextView
            android:id="@+id/user_stats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.App.BodyMedium.Variant"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="10k post · 950 comment karma · since 01/01/21"/>

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_app_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_begin="?attr/actionBarSize" />

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/user_banner"
            app:layout_constraintStart_toStartOf="parent"
            style="@style/TabLayoutStyle"/>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/view_pager"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tabs"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <com.omeron.ui.common.widget.InfoBarView
            android:id="@+id/info_retry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tabs"
            android:layout_marginTop="@dimen/info_bar_margin_top"
            style="@style/InfoBarStyle"
            app:textMessage="@string/network_retry_message"
            app:textAction="@string/network_retry_action"
            android:visibility="gone"
            tools:visibility="visible"/>

    </androidx.constraintlayout.motion.widget.MotionLayout>
</layout>