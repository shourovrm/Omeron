<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <include
        android:id="@id/include_post_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/image_post_preview"
        layout="@layout/include_post_info"/>

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/image_post_preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="H,4:3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/include_post_info"
        app:layout_constraintBottom_toTopOf="@id/text_post_title"
        android:layout_marginVertical="@dimen/post_margin_top_small"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/SquareImageViewStyle"
        android:contentDescription="@string/post_preview_image_description"
        tools:src="@tools:sample/backgrounds/scenic"/>

    <TextView
        android:id="@+id/text_post_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearancePostTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/image_post_preview"
        app:layout_constraintBottom_toTopOf="@id/include_post_flairs"
        android:layout_marginHorizontal="@dimen/post_title_margin"
        tools:text="This is a post" />

    <include
        android:id="@+id/include_post_flairs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_post_title"
        app:layout_constraintBottom_toTopOf="@id/awards"
        android:layout_marginTop="@dimen/post_margin_top_small"
        layout="@layout/include_post_flairs"/>

    <com.omeron.ui.common.widget.AwardView
        android:id="@+id/awards"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/include_post_flairs"
        app:layout_constraintBottom_toTopOf="@id/include_post_metrics"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="@dimen/post_margin_top_small"
        android:layout_marginTop="@dimen/post_margin_top_large"
        android:paddingVertical="@dimen/award_chip_padding_vertical_post"
        android:paddingHorizontal="@dimen/award_chip_padding_horizontal_post"
        app:textStyle="@style/TextAppearanceAwardPost"/>

    <include
        android:id="@+id/include_post_metrics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/awards"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginTop="@dimen/post_margin_top_small"
        layout="@layout/include_post_metrics"/>

    <com.omeron.ui.common.widget.CardButton
        android:id="@+id/button_type_indicator"
        android:layout_width="@dimen/post_type_indicator_size"
        android:layout_height="@dimen/post_type_indicator_size"
        app:layout_constraintStart_toStartOf="@id/image_post_preview"
        app:layout_constraintBottom_toBottomOf="@id/image_post_preview"
        android:layout_margin="@dimen/post_type_indicator_margin"
        android:focusable="false"
        android:clickable="false"
        style="@style/CardButtonStyle"
        tools:icon="@drawable/ic_play"/>

    <ImageView
        android:id="@+id/image_post_marker"
        android:layout_width="@dimen/post_marker_size"
        android:layout_height="@dimen/post_marker_size"
        app:layout_constraintEnd_toEndOf="@id/image_post_preview"
        app:layout_constraintTop_toTopOf="@id/image_post_preview"
        android:layout_margin="@dimen/post_marker_inset"
        android:padding="@dimen/post_marker_padding"
        android:background="@drawable/marker_scrim"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:srcCompat="@drawable/ic_marker_tick"
        tools:visibility="visible"/>

</androidx.constraintlayout.widget.ConstraintLayout>
