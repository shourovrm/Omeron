<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/image_filmstrip_preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        tools:src="@tools:sample/backgrounds/scenic"/>

    <LinearLayout
        android:id="@+id/badge_filmstrip"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/post_badge_height"
        android:layout_margin="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:background="@drawable/filmstrip_badge_background"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="@id/image_filmstrip_preview"
        app:layout_constraintTop_toTopOf="@id/image_filmstrip_preview">

        <ImageView
            android:id="@+id/icon_filmstrip_badge"
            android:layout_width="@dimen/post_badge_icon_size"
            android:layout_height="@dimen/post_badge_icon_size"
            android:importantForAccessibility="no"
            app:tint="@color/white"
            tools:src="@drawable/ic_play"/>

        <TextView
            android:id="@+id/text_filmstrip_badge_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_4"
            android:textColor="@color/white"
            android:textAppearance="@style/TextAppearance.App.LabelMedium"
            android:visibility="gone"
            tools:text="5"
            tools:visibility="visible"/>
    </LinearLayout>

    <ImageView
        android:id="@+id/image_filmstrip_marker"
        android:layout_width="@dimen/post_marker_size_small"
        android:layout_height="@dimen/post_marker_size_small"
        app:layout_constraintStart_toStartOf="@id/image_filmstrip_preview"
        app:layout_constraintTop_toTopOf="@id/image_filmstrip_preview"
        android:layout_margin="@dimen/post_marker_inset_small"
        android:padding="@dimen/post_marker_padding_small"
        android:background="@drawable/marker_scrim"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:srcCompat="@drawable/ic_marker_loop"
        tools:visibility="visible"/>

</androidx.constraintlayout.widget.ConstraintLayout>
