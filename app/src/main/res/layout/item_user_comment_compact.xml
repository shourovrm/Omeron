<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/comment_padding_horizontal"
    android:paddingEnd="@dimen/space_4"
    android:paddingVertical="@dimen/space_12"
    android:background="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_comment_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.App.BodySmall.Variant"
            tools:text="u/author · r/community · 5h"/>

        <TextView
            android:id="@+id/text_comment_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.App.BodyMedium"
            tools:text="The body of a saved comment stops after two lines and ends with an ellipsis when it runs longer."/>

    </LinearLayout>

    <ImageButton
        android:id="@+id/button_comment_more"
        android:layout_width="@dimen/post_action_button_size"
        android:layout_height="@dimen/post_action_button_size"
        android:layout_marginStart="@dimen/space_4"
        android:padding="@dimen/post_action_button_padding"
        android:scaleType="fitCenter"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/post_more_description"
        app:srcCompat="@drawable/ic_more"
        app:tint="@color/text_color_secondary"/>

</LinearLayout>
