<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/post_margin_horizontal"
    android:layout_marginVertical="@dimen/post_margin_vertical">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/image_gallery_preview"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/SquareImageViewStyle"
        android:contentDescription="@null"
        tools:src="@tools:sample/backgrounds/scenic"/>

    <com.omeron.ui.common.widget.CardButton
        android:id="@+id/button_gallery_type_indicator"
        android:layout_width="@dimen/post_type_indicator_size"
        android:layout_height="@dimen/post_type_indicator_size"
        app:layout_constraintStart_toStartOf="@id/image_gallery_preview"
        app:layout_constraintBottom_toBottomOf="@id/image_gallery_preview"
        android:layout_margin="@dimen/post_type_indicator_margin"
        android:focusable="false"
        android:clickable="false"
        style="@style/CardButtonStyle"
        tools:icon="@drawable/ic_play"/>

    <TextView
        android:id="@+id/text_gallery_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/post_margin_top_small"
        android:maxLines="3"
        android:ellipsize="end"
        android:textAppearance="@style/TextAppearancePostTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/image_gallery_preview"
        tools:text="This is a compact gallery tile title that can wrap onto three lines"/>

    <TextView
        android:id="@+id/text_gallery_score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/post_margin_top_small"
        android:layout_marginBottom="@dimen/post_margin_top_small"
        android:textAppearance="@style/TextAppearance.App.BodyMedium.Variant"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/text_gallery_title"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:text="14.3k"/>

    <ImageView
        android:id="@+id/image_gallery_marker"
        android:layout_width="@dimen/post_marker_size_small"
        android:layout_height="@dimen/post_marker_size_small"
        app:layout_constraintEnd_toEndOf="@id/image_gallery_preview"
        app:layout_constraintTop_toTopOf="@id/image_gallery_preview"
        android:layout_margin="@dimen/post_marker_inset_small"
        android:padding="@dimen/post_marker_padding_small"
        android:background="@drawable/marker_scrim"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:srcCompat="@drawable/ic_marker_tick"
        tools:visibility="visible"/>

</androidx.constraintlayout.widget.ConstraintLayout>
