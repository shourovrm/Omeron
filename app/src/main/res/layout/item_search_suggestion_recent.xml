<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/list_item_one_line"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/space_16"
    android:background="?attr/selectableItemBackground">

    <ImageView
        android:layout_width="@dimen/avatar_size"
        android:layout_height="@dimen/avatar_size"
        android:padding="@dimen/space_8"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_search"
        app:tint="?attr/colorControlNormal"/>

    <TextView
        android:id="@+id/recent_query"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/space_12"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceBody1"
        tools:text="kotlin coroutines"/>

    <ImageButton
        android:id="@+id/button_remove"
        tools:ignore="ContentDescription"
        android:layout_width="@dimen/touch_target"
        android:layout_height="@dimen/touch_target"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="@dimen/space_12"
        app:tint="?attr/colorControlNormal"
        app:srcCompat="@drawable/ic_close"
        tools:contentDescription="Remove kotlin coroutines from recent searches"/>

</LinearLayout>
