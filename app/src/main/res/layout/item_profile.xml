<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="profile"
            type="com.omeron.data.model.db.Profile" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/space_56"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/space_16"
        android:paddingEnd="@dimen/space_4"
        android:background="?attr/selectableItemBackground">

        <com.omeron.ui.common.widget.AvatarView
            android:id="@+id/profile_avatar"
            android:layout_width="@dimen/manage_row_image_size"
            android:layout_height="@dimen/manage_row_image_size"
            android:importantForAccessibility="no"
            app:text="@{profile.name}"
            tools:text="DE"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_12"
            android:orientation="vertical">

            <TextView
                android:id="@+id/profile_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@{profile.name}"
                android:textAppearance="@style/TextAppearance.App.TitleMedium"
                tools:text="Default profile"/>

            <TextView
                android:id="@+id/profile_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceCaption"
                android:textColor="@color/text_color_post_info"
                tools:text="Current · 6 communities · 12 saved"/>

        </LinearLayout>

        <ImageButton
            android:id="@+id/edit_button"
            android:layout_width="@dimen/space_48"
            android:layout_height="@dimen/space_48"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/icon_tint"
            android:src="@drawable/ic_edit"
            android:contentDescription="@string/profile_edit_description"/>

    </LinearLayout>

</layout>
