<?xml version="1.0" encoding="utf-8"?>
<merge
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:parentTag="androidx.constraintlayout.widget.ConstraintLayout">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/avatar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:shapeAppearanceOverlay="@style/CircularImageViewStyle"
        android:background="@color/colorPrimary"
        tools:layout_width="@dimen/subreddit_image_size_expanded"
        tools:layout_height="@dimen/subreddit_image_size_expanded" />

    <TextView
        android:id="@+id/initials"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="@dimen/space_4"
        app:layout_constraintStart_toStartOf="@id/avatar"
        app:layout_constraintEnd_toEndOf="@id/avatar"
        app:layout_constraintTop_toTopOf="@id/avatar"
        app:layout_constraintBottom_toBottomOf="@id/avatar"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.App.TitleSmall"
        app:autoSizeTextType="uniform"
        app:autoSizeMinTextSize="@dimen/avatar_text_min_size"
        tools:text="ST"/>

</merge>