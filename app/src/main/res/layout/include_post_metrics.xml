<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <variable
            name="post"
            type="com.omeron.data.model.db.PostEntity" />
    </data>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/image_vote_icon"
            android:layout_width="@dimen/post_meta_icon_size"
            android:layout_height="@dimen/post_meta_icon_size"
            android:layout_marginStart="@dimen/space_12"
            android:importantForAccessibility="no"
            app:tint="@color/text_color_secondary"
            app:srcCompat="@drawable/ic_votes"/>

        <TextView
            android:id="@+id/text_post_vote"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/post_icon_text_margin"
            android:fontFeatureSettings="tnum"
            android:textAppearance="@style/TextAppearance.App.BodySmall.Variant"
            android:text="@{post.score}"
            tools:text="12345"/>

        <TextView
            android:id="@+id/text_post_ratio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/post_margin_horizontal"
            android:fontFeatureSettings="tnum"
            android:textAppearance="@style/TextAppearance.App.BodySmall.Variant"
            tools:text="50%"/>

        <ImageView
            android:id="@+id/image_comments_icon"
            android:layout_width="@dimen/post_meta_icon_size"
            android:layout_height="@dimen/post_meta_icon_size"
            android:layout_marginStart="@dimen/space_12"
            android:importantForAccessibility="no"
            app:tint="@color/text_color_secondary"
            app:srcCompat="@drawable/ic_comments"/>

        <TextView
            android:id="@+id/text_post_comments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/post_icon_text_margin"
            android:fontFeatureSettings="tnum"
            android:textAppearance="@style/TextAppearance.App.BodySmall.Variant"
            android:text="@{post.commentsNumber}"
            tools:text="1234"/>

        <com.omeron.ui.common.widget.CheckableImageView
            android:id="@+id/button_save"
            android:layout_width="@dimen/post_action_button_size"
            android:layout_height="@dimen/post_action_button_size"
            android:padding="@dimen/post_action_button_padding"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/post_save_description"
            app:srcCompat="@drawable/bookmark" />

        <ImageButton
            android:id="@+id/button_more"
            android:layout_width="@dimen/post_action_button_size"
            android:layout_height="@dimen/post_action_button_size"
            android:layout_marginEnd="@dimen/space_4"
            android:padding="@dimen/post_action_button_padding"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/post_more_description"
            app:srcCompat="@drawable/ic_more"/>

    </LinearLayout>
</layout>
