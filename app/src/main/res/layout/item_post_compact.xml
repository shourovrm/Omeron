<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/list_item_two_line">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/image_compact_preview"
        android:layout_width="@dimen/list_item_two_line"
        android:layout_height="@dimen/list_item_two_line"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/SquareImageViewStyle"
        android:contentDescription="@null"
        tools:src="@tools:sample/backgrounds/scenic"/>

    <!-- A post without a picture shows its community's colour and first letter instead. -->
    <TextView
        android:id="@+id/text_compact_initial"
        android:layout_width="@dimen/list_item_two_line"
        android:layout_height="@dimen/list_item_two_line"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:textColor="@android:color/white"
        android:textAppearance="@style/TextAppearance.App.HeadlineSmall"
        android:visibility="gone"
        tools:text="R"/>

    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrier_compact_thumbnail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="end"
        app:constraint_referenced_ids="image_compact_preview,text_compact_initial"/>

    <com.omeron.ui.common.widget.CardButton
        android:id="@+id/button_compact_type_indicator"
        android:layout_width="@dimen/post_type_indicator_size"
        android:layout_height="@dimen/post_type_indicator_size"
        app:layout_constraintStart_toStartOf="@id/image_compact_preview"
        app:layout_constraintBottom_toBottomOf="@id/image_compact_preview"
        android:layout_margin="@dimen/post_type_indicator_margin"
        android:focusable="false"
        android:clickable="false"
        style="@style/CardButtonStyle"
        tools:icon="@drawable/ic_play"/>

    <ImageView
        android:id="@+id/image_compact_marker"
        android:layout_width="@dimen/post_marker_size_small"
        android:layout_height="@dimen/post_marker_size_small"
        app:layout_constraintEnd_toEndOf="@id/image_compact_preview"
        app:layout_constraintTop_toTopOf="@id/image_compact_preview"
        android:layout_margin="@dimen/post_marker_inset_small"
        android:padding="@dimen/post_marker_padding_small"
        android:background="@drawable/marker_scrim"
        android:importantForAccessibility="no"
        android:visibility="gone"
        app:srcCompat="@drawable/ic_marker_tick"
        tools:visibility="visible"/>

    <TextView
        android:id="@+id/text_compact_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toEndOf="@id/barrier_compact_thumbnail"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="@dimen/space_12"
        android:layout_marginEnd="@dimen/space_16"
        android:layout_marginTop="@dimen/space_4"
        android:maxLines="2"
        android:ellipsize="end"
        android:textAppearance="@style/TextAppearancePostTitle"
        tools:text="This is a compact post title that can wrap onto two lines before it ellipsizes"/>

    <!-- The community and age come first and keep their size; the counts stay at the end. -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="@id/text_compact_title"
        app:layout_constraintEnd_toEndOf="@id/text_compact_title"
        app:layout_constraintTop_toBottomOf="@id/text_compact_title"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintVertical_bias="1"
        android:layout_marginBottom="@dimen/space_4"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/text_compact_subreddit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAppearance="@style/TextAppearancePostCommunity"
            tools:text="r/LocalLLaMA"/>

        <TextView
            android:id="@+id/text_compact_age"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_4"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAppearance="@style/TextAppearancePostEdgePrint"
            tools:text="· 4h"/>

        <ImageView
            android:id="@+id/image_compact_score_icon"
            android:layout_width="@dimen/post_meta_icon_size"
            android:layout_height="@dimen/post_meta_icon_size"
            android:importantForAccessibility="no"
            app:tint="@color/text_color_secondary"
            app:srcCompat="@drawable/ic_votes"/>

        <TextView
            android:id="@+id/text_compact_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/post_icon_text_margin"
            android:fontFeatureSettings="tnum"
            android:textAppearance="@style/TextAppearance.App.BodySmall.Variant"
            tools:text="14.3k"/>

        <ImageView
            android:id="@+id/image_compact_comments_icon"
            android:layout_width="@dimen/post_meta_icon_size"
            android:layout_height="@dimen/post_meta_icon_size"
            android:layout_marginStart="@dimen/space_12"
            android:importantForAccessibility="no"
            app:tint="@color/text_color_secondary"
            app:srcCompat="@drawable/ic_comments"/>

        <TextView
            android:id="@+id/text_compact_comments"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/post_icon_text_margin"
            android:fontFeatureSettings="tnum"
            android:textAppearance="@style/TextAppearance.App.BodySmall.Variant"
            tools:text="1.2k"/>

        <!-- Hidden in the feed, where long press opens the menu; the profile lists use long press to
             select rows, so they show this button to keep the menu reachable. -->
        <ImageButton
            android:id="@+id/button_compact_more"
            android:layout_width="@dimen/post_action_button_size"
            android:layout_height="@dimen/post_action_button_size"
            android:padding="@dimen/post_action_button_padding"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/post_more_description"
            android:visibility="gone"
            app:srcCompat="@drawable/ic_more"
            app:tint="@color/text_color_secondary"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
