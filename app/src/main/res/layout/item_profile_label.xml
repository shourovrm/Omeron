<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/icon_button_size"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/space_16"
    android:paddingEnd="@dimen/space_8"
    android:paddingTop="@dimen/space_8">

    <TextView
        android:id="@+id/label_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textAppearance="@style/TextAppearance.App.LabelLarge"
        android:textColor="@color/text_color_post_info"
        android:accessibilityHeading="true"
        tools:text="Today"/>

    <!-- Text action at the end of the label; hidden on labels that carry none. -->
    <TextView
        android:id="@+id/label_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/touch_target"
        android:gravity="center"
        android:paddingHorizontal="@dimen/space_8"
        android:background="?attr/selectableItemBackground"
        android:text="@string/profile_history_clear"
        android:textAppearance="@style/TextAppearance.App.LabelLarge"
        android:textColor="@color/colorPrimary"
        android:visibility="gone"
        tools:visibility="visible"/>

    <!-- Selects or clears every post of this day; shown only while selecting history. -->
    <ImageButton
        android:id="@+id/label_select"
        android:layout_width="@dimen/touch_target"
        android:layout_height="@dimen/touch_target"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/profile_history_select_day"
        android:visibility="gone"
        app:srcCompat="@drawable/ic_check_box_outline_blank"
        app:tint="?attr/colorOnSurfaceVariant"
        tools:visibility="visible"/>

</LinearLayout>
