<?xml version="1.0" encoding="utf-8"?>
<com.omeron.ui.common.ElasticDragDismissFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:dragDismissDistance="@dimen/post_details_dismiss_distance"
    app:dragDismissScale="@dimen/post_details_dismiss_scale"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="?attr/colorSurface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layout_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:id="@+id/single_thread_layout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_target"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/find_bar"
            android:background="?attr/colorPrimaryContainer">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textAppearance="@style/TextAppearance.App.LabelLarge"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:text="@string/post_load_discussion"/>

        </FrameLayout>

        <include
            android:id="@+id/app_bar"
            layout="@layout/layout_appbar_post"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>

        <!-- Shown from the post menu; collapses to zero height while gone. -->
        <LinearLayout
            android:id="@+id/find_bar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/app_bar"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/space_16"
            android:background="?attr/colorSurface"
            android:visibility="gone">

            <EditText
                android:id="@+id/input_find"
                android:layout_width="0dp"
                android:layout_height="@dimen/touch_target"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/find_hint"
                android:importantForAutofill="no"
                android:inputType="text"
                android:imeOptions="actionSearch|flagNoPersonalizedLearning"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBody1"/>

            <TextView
                android:id="@+id/text_find_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/space_8"
                android:textAppearance="@style/TextAppearance.App.LabelMedium"
                android:textColor="?attr/colorOnSurfaceVariant"/>

            <ImageButton
                android:id="@+id/button_find_previous"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/find_previous"
                android:rotation="180"
                android:src="@drawable/ic_expand_more"
                app:tint="?attr/colorControlNormal"/>

            <ImageButton
                android:id="@+id/button_find_next"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/find_next"
                android:src="@drawable/ic_expand_more"
                app:tint="?attr/colorControlNormal"/>

            <ImageButton
                android:id="@+id/button_find_close"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/find_close"
                android:src="@drawable/ic_close"
                app:tint="?attr/colorControlNormal"/>

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list_comments"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/single_thread_layout"
            app:layout_constraintBottom_toBottomOf="parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.omeron.ui.common.ElasticDragDismissFrameLayout>