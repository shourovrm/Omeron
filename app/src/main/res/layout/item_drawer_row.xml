<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:background="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/row_icon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_multireddit"
        android:padding="2dp"
        android:importantForAccessibility="no"
        app:tint="?attr/colorControlNormal"/>

    <com.omeron.ui.common.widget.AvatarView
        android:id="@+id/row_avatar"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:importantForAccessibility="no"
        tools:text="AN"/>

    <TextView
        android:id="@+id/row_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceBody1"
        tools:text="r/android"/>

    <TextView
        android:id="@+id/row_end_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textAppearance="?attr/textAppearanceCaption"
        android:textColor="@color/text_color_post_info"
        tools:text="3 members"/>

</LinearLayout>
