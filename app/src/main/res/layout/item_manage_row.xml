<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/space_56"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/space_16"
    android:paddingEnd="@dimen/space_4"
    android:background="?attr/selectableItemBackground">

    <ImageView
        android:id="@+id/row_icon"
        android:layout_width="@dimen/manage_row_image_size"
        android:layout_height="@dimen/manage_row_image_size"
        android:src="@drawable/ic_multireddit"
        android:padding="6dp"
        android:importantForAccessibility="no"
        app:tint="?attr/colorControlNormal"/>

    <com.omeron.ui.common.widget.AvatarView
        android:id="@+id/row_avatar"
        android:layout_width="@dimen/manage_row_image_size"
        android:layout_height="@dimen/manage_row_image_size"
        android:importantForAccessibility="no"
        tools:text="AN"/>

    <LinearLayout
        android:id="@+id/row_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/space_12"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.App.TitleMedium"
            tools:text="r/android"/>

        <TextView
            android:id="@+id/row_secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="?attr/textAppearanceCaption"
            android:textColor="@color/text_color_post_info"
            tools:text="Joined 2y ago · in Dev"/>

    </LinearLayout>

    <ImageButton
        android:id="@+id/button_toggle_hidden"
        tools:ignore="ContentDescription"
        android:layout_width="@dimen/space_48"
        android:layout_height="@dimen/space_48"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="@color/icon_tint"
        android:src="@drawable/ic_visibility"
        tools:contentDescription="Hide"/>

    <ImageButton
        android:id="@+id/button_more"
        android:layout_width="@dimen/space_48"
        android:layout_height="@dimen/space_48"
        android:background="?attr/selectableItemBackgroundBorderless"
        app:tint="@color/icon_tint"
        android:src="@drawable/ic_more"
        android:contentDescription="@string/manage_more_actions"/>

</LinearLayout>
