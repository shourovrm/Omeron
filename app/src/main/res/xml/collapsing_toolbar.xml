<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <Transition
        app:constraintSetEnd="@id/collapsed"
        app:constraintSetStart="@id/expanded">

        <OnSwipe
            app:dragDirection="dragUp"
            app:touchAnchorId="@id/pull_refresh"
            app:touchAnchorSide="top" />

    </Transition>

    <ConstraintSet android:id="@+id/expanded">
        <Constraint
            android:id="@id/subreddit_banner"
            android:layout_width="match_parent"
            android:layout_height="@dimen/subreddit_banner_height"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <CustomAttribute
                app:attributeName="imageAlpha"
                app:customIntegerValue="@integer/banner_image_alpha" />
        </Constraint>
        <Constraint
            android:id="@id/subreddit_image"
            android:layout_width="@dimen/subreddit_image_size_expanded"
            android:layout_height="@dimen/subreddit_image_size_expanded"
            android:layout_marginStart="@dimen/space_16"
            android:layout_marginBottom="@dimen/space_12"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/subreddit_banner">
        </Constraint>
        <Constraint
            android:id="@id/subreddit_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_12"
            android:layout_marginEnd="@dimen/space_8"
            app:layout_constraintStart_toEndOf="@id/subreddit_image"
            app:layout_constraintEnd_toStartOf="@id/subreddit_join_button"
            app:layout_constraintTop_toTopOf="@id/subreddit_image"
            app:layout_constraintBottom_toTopOf="@id/subreddit_stats"
            app:layout_constraintVertical_chainStyle="packed">
        </Constraint>
        <Constraint
            android:id="@id/subreddit_stats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="@id/subreddit_name"
            app:layout_constraintEnd_toEndOf="@id/subreddit_name"
            app:layout_constraintTop_toBottomOf="@id/subreddit_name"
            app:layout_constraintBottom_toBottomOf="@id/subreddit_image"/>
        <Constraint
            android:id="@id/subreddit_join_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/subreddit_image"
            app:layout_constraintBottom_toBottomOf="@id/subreddit_image"/>
        <Constraint
            android:id="@id/pull_refresh">
            <PropertySet
                android:visibility="visible"
                app:visibilityMode="ignore" />
        </Constraint>
    </ConstraintSet>

    <ConstraintSet android:id="@+id/collapsed">
        <Constraint
            android:id="@id/subreddit_banner"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <CustomAttribute
                app:attributeName="imageAlpha"
                app:customIntegerValue="0" />
        </Constraint>
        <Constraint
            android:id="@id/subreddit_image"
            android:layout_width="@dimen/subreddit_image_size_collapsed"
            android:layout_height="@dimen/subreddit_image_size_collapsed"
            android:layout_marginStart="@dimen/app_bar_margin"
            app:layout_constraintStart_toEndOf="@id/back_card"
            app:layout_constraintTop_toTopOf="@id/subreddit_banner"
            app:layout_constraintBottom_toBottomOf="@id/subreddit_banner">
        </Constraint>
        <Constraint
            android:id="@id/subreddit_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/app_bar_margin"
            app:layout_constraintStart_toEndOf="@id/subreddit_image"
            app:layout_constraintEnd_toStartOf="@id/sort_icon"
            app:layout_constraintBottom_toBottomOf="@id/subreddit_banner"
            app:layout_constraintTop_toTopOf="@id/subreddit_banner">
        </Constraint>
        <Constraint
            android:id="@id/subreddit_stats"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="@id/subreddit_name"
            app:layout_constraintEnd_toEndOf="@id/subreddit_name"
            app:layout_constraintTop_toBottomOf="@id/subreddit_name"
            android:alpha="0"/>
        <!-- Invisible, not only transparent: a transparent button under the bar icons would
             still take their taps. -->
        <Constraint
            android:id="@id/subreddit_join_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_16"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/subreddit_banner"
            android:alpha="0"
            android:visibility="invisible"/>
        <Constraint
            android:id="@id/pull_refresh">
            <PropertySet
                android:visibility="visible"
                app:visibilityMode="ignore" />
        </Constraint>
    </ConstraintSet>

</MotionScene>
