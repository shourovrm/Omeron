<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/navigation_graph"
    app:startDestination="@+id/home">

    <!-- Bottom Navigation -->
    <include app:graph="@navigation/home" />
    <include app:graph="@navigation/search" />
    <include app:graph="@navigation/subscriptions" />
    <include app:graph="@navigation/profile" />
    <include app:graph="@navigation/settings" />

    <!-- Global Destinations -->
    <include app:graph="@navigation/post" />
    <include app:graph="@navigation/subreddit" />
    <include app:graph="@navigation/multireddit" />
    <include app:graph="@navigation/user" />

    <!-- Global Actions -->
    <action
        android:id="@+id/openSubreddit"
        app:destination="@id/subreddit">
        <argument
            android:name="subreddit"
            app:argType="string" />
    </action>

    <action
        android:id="@+id/openUser"
        app:destination="@id/user">
        <argument
            android:name="user"
            app:argType="string"/>
    </action>

    <action
        android:id="@+id/openMultireddit"
        app:destination="@id/multireddit">
        <argument
            android:name="multireddit_id"
            app:argType="long" />
    </action>

</navigation>